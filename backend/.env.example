# Rayeva Environment Configuration
# Copy this to .env and fill in your values

# AI Provider
GEMINI_API_KEY=your_gemini_key_here

# PostgreSQL (primary database)
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=rayeva_db
PG_USER=your_pg_user
PG_PASSWORD=your_pg_password

# MongoDB (logging + conversations)
MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net/rayeva_logs

# Server
PORT=4000
NODE_ENV=development

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
